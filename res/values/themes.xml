<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ProPDF" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/propdf_primary</item>
        <item name="colorPrimaryDark">@color/propdf_primary_dark</item>
        <item name="colorAccent">@color/propdf_accent</item>
        <item name="android:windowBackground">@color/propdf_background</item>
        <item name="android:statusBarColor">@color/propdf_status_bar</item>
        <item name="android:navigationBarColor">@color/propdf_nav_bar</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.ProPDF.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/propdf_primary_light</item>
        <item name="colorPrimaryDark">@color/propdf_primary_dark_light</item>
        <item name="colorAccent">@color/propdf_accent</item>
        <item name="android:windowBackground">@color/propdf_background_light</item>
        <item name="android:statusBarColor">@color/propdf_status_bar_light</item>
        <item name="android:navigationBarColor">@color/propdf_nav_bar_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
